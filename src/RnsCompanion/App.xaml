<Application x:Class="RnsCompanion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>

    <!-- ═══════════ Палитра (тактическая тема rnserver.ru + акценты логотипа) ═══════════ -->
    <!-- base -->
    <SolidColorBrush x:Key="Bg0" Color="#FF06070B"/>
    <SolidColorBrush x:Key="Bg1" Color="#FF0A1020"/>
    <SolidColorBrush x:Key="Bg2" Color="#FF10182A"/>
    <!-- accents -->
    <SolidColorBrush x:Key="Amber" Color="#FFF5C842"/>
    <SolidColorBrush x:Key="Green" Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="Blue" Color="#FF60A5FA"/>
    <SolidColorBrush x:Key="Red" Color="#FFEF4444"/>
    <!-- text -->
    <SolidColorBrush x:Key="Text0" Color="#F0F5F8FF"/>
    <SolidColorBrush x:Key="Text1" Color="#B8F5F8FF"/>
    <SolidColorBrush x:Key="Text2" Color="#8CF5F8FF"/>
    <SolidColorBrush x:Key="TextDim" Color="#4DF5F8FF"/>
    <!-- lines / panels -->
    <SolidColorBrush x:Key="LineBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="LineStrong" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="LineAmber" Color="#59F5C842"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#C70E121C"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#B8141C2C"/>
    <SolidColorBrush x:Key="AmberDim" Color="#22F5C842"/>
    <SolidColorBrush x:Key="HoverFill" Color="#0FFFFFFF"/>

    <!-- пилюли статуса -->
    <SolidColorBrush x:Key="PillIdleBg" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PillIdleFg" Color="#8CF5F8FF"/>
    <SolidColorBrush x:Key="PillBusyBg" Color="#2EF5C842"/>
    <SolidColorBrush x:Key="PillBusyFg" Color="#FFF5C842"/>
    <SolidColorBrush x:Key="PillOkBg" Color="#2E4ADE80"/>
    <SolidColorBrush x:Key="PillOkFg" Color="#FF4ADE80"/>

    <!-- градиенты -->
    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF0C1324" Offset="0"/>
      <GradientStop Color="#FF0A1020" Offset="0.45"/>
      <GradientStop Color="#FF06070B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#E0141C2C" Offset="0"/>
      <GradientStop Color="#D00E121C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AmberGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFD65C" Offset="0"/>
      <GradientStop Color="#FFF0B92E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AmberGradHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFE27A" Offset="0"/>
      <GradientStop Color="#FFF5C842" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════ Типографика ═══════════ -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="BaseText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text0}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ═══════════ Карточка ═══════════ -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- ═══════════ Кнопки ═══════════ -->
    <!-- акцентная (янтарь) -->
    <Style x:Key="BtnAmber" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AmberGrad}"/>
      <Setter Property="Foreground" Value="#FF141109"/>
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AmberGradHover}"/>
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#FFF5C842" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFD9AE2E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#29F5C842"/>
                <Setter Property="Foreground" Value="#61F5F8FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- контурная -->
    <Style x:Key="BtnGhost" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text1}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                <Setter Property="Foreground" Value="{StaticResource Text0}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#55F5F8FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- опасная (стоп) -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
      <Setter Property="Foreground" Value="{StaticResource Red}"/>
      <Setter Property="BorderBrush" Value="#59EF4444"/>
    </Style>

    <!-- подключение к серверу: заметная, но не главная (янтарная обводка + оттенок) -->
    <Style x:Key="BtnConnect" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
      <Setter Property="Background" Value="#0DF5C842"/>
      <Setter Property="BorderBrush" Value="#40F5C842"/>
      <Setter Property="Foreground" Value="{StaticResource Amber}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- кнопка заголовка окна (min/close) -->
    <Style x:Key="BtnChrome" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="Foreground" Value="{StaticResource Text0}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnChromeClose" TargetType="Button" BasedOn="{StaticResource BtnChrome}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFEF4444"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Переключатель (toggle-switch) — стиль CheckBox по умолчанию ═══════════ -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text1}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Grid Width="38" Height="20" VerticalAlignment="Center">
                <Border x:Name="track" CornerRadius="10" Background="#1FFFFFFF"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                <Border x:Name="thumb" Width="14" Height="14" CornerRadius="7"
                        Background="{StaticResource Text2}"
                        HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#3DF5C842"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Amber}"/>
                <Setter TargetName="thumb" Property="Background" Value="{StaticResource Amber}"/>
                <Setter TargetName="thumb" Property="Margin" Value="21,0,0,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#55F5F8FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ RadioButton (сегменты) ═══════════ -->
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="8" Padding="12,6"
                    Background="Transparent" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AmberDim}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}"/>
                <Setter Property="Foreground" Value="{StaticResource Amber}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Прогресс-бар ═══════════ -->
    <Style x:Key="SeedProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Amber}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
              <Border x:Name="PART_Track" CornerRadius="5">
                <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                  <Border CornerRadius="5">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFF0B92E" Offset="0"/>
                        <GradientStop Color="#FFFFD65C" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                </Decorator>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Поле ввода ═══════════ -->
    <Style x:Key="TacTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="#0DFFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Text0}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{StaticResource Amber}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AmberDim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineAmber}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ═══════════ Тонкий скроллбар ═══════════ -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="true">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="th" CornerRadius="4" Background="#29FFFFFF" Margin="1,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Opacity="0" IsTabStop="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Opacity="0" IsTabStop="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
