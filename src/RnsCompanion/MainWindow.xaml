<Window x:Class="RnsCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RNS Companion" Width="720" Height="780" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Пункт навигации в сайдбаре: полоса-акцент слева при выборе -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="9" Padding="12,9" Background="Transparent">
              <Grid>
                <Border x:Name="accent" Width="3" CornerRadius="2" HorizontalAlignment="Left"
                        Background="{StaticResource Amber}" Visibility="Collapsed"
                        Margin="-8,0,0,0"/>
                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#14F5C842"/>
                <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource Amber}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}"/>
                <Setter Property="Foreground" Value="{StaticResource Text0}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Внешняя рамка: тень + скруглённые углы (Clip обновляется из кода) -->
  <Border x:Name="RootBorder" Margin="10" CornerRadius="16" Background="{StaticResource WindowBg}"
          BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
    </Border.Effect>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ═══ Сайдбар ═══ -->
      <Border Grid.Column="0" x:Name="SidebarBorder" Background="#08FFFFFF"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- бренд -->
            <RowDefinition Height="Auto"/>  <!-- аккаунт -->
            <RowDefinition Height="*"/>     <!-- навигация -->
            <RowDefinition Height="Auto"/>  <!-- версия -->
          </Grid.RowDefinitions>

          <!-- бренд (за него можно таскать окно) -->
          <StackPanel Grid.Row="0" Margin="16,16,16,14" Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="11" Background="#14FFFFFF"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
              <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28"
                     Margin="5"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="RNS Companion" Style="{StaticResource BaseText}"
                         FontFamily="{StaticResource FontDisplay}" FontWeight="Bold"
                         FontSize="14"/>
              <TextBlock Text="rnserver.ru" Style="{StaticResource HintText}" FontSize="10.5"/>
            </StackPanel>
          </StackPanel>

          <!-- аккаунт -->
          <Border Grid.Row="1" Margin="10,6,10,10" Padding="12,10" CornerRadius="12"
                  Background="#0AFFFFFF" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1">
            <Grid>
              <!-- Не авторизован -->
              <StackPanel x:Name="LoginPanel">
                <Button x:Name="BtnLogin" Content="Войти через сайт"
                        Style="{StaticResource BtnAmber}" Padding="10,8" FontSize="12.5"/>
                <TextBlock x:Name="TxtAuthProgress" Style="{StaticResource HintText}"
                           FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"/>
              </StackPanel>

              <!-- Авторизован -->
              <Grid x:Name="UserPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Green}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAccount" Style="{StaticResource BaseText}" FontSize="12.5"
                               Margin="9,0,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnLogout" Content="Выйти"
                        Style="{StaticResource BtnGhost}" Padding="10,5" FontSize="11.5"
                        VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Border>

          <!-- навигация -->
          <StackPanel Grid.Row="2" Margin="10,4,10,0">
            <RadioButton x:Name="NavSeed" Content="Набор игроков" Style="{StaticResource NavItem}"
                         IsChecked="True"/>
            <RadioButton x:Name="NavVip" Content="VIP и бонусы" Style="{StaticResource NavItem}"/>
            <RadioButton x:Name="NavJournal" Content="Журнал" Style="{StaticResource NavItem}"/>
          </StackPanel>

          <!-- версия -->
          <TextBlock Grid.Row="3" x:Name="TxtVersion" Style="{StaticResource HintText}"
                     FontSize="11" Margin="16,0,16,12"/>
        </Grid>
      </Border>

      <!-- ═══ Контент ═══ -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>  <!-- title bar -->
          <RowDefinition Height="Auto"/>  <!-- заголовок страницы -->
          <RowDefinition Height="*"/>     <!-- страницы -->
          <RowDefinition Height="Auto"/>  <!-- сессия -->
          <RowDefinition Height="Auto"/>  <!-- плашка обновления -->
          <RowDefinition Height="Auto"/>  <!-- статус-бар -->
        </Grid.RowDefinitions>

        <!-- Кастомный title bar -->
        <Border Grid.Row="0" x:Name="TitleBar" Padding="14,6,8,6" Background="Transparent">
          <Grid>
            <TextBlock Text="Русский Народный Сервер" Style="{StaticResource BaseText}"
                       Foreground="{StaticResource Text2}" FontSize="12"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnMinimize" Content="—" Style="{StaticResource BtnChrome}"/>
              <Button x:Name="BtnClose" Content="✕" Style="{StaticResource BtnChromeClose}"
                      Margin="4,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Заголовок страницы -->
        <Grid Grid.Row="1" Margin="18,4,18,12">
          <TextBlock x:Name="TxtPageTitle" Text="Набор игроков"
                     Style="{StaticResource BaseText}" FontFamily="{StaticResource FontDisplay}"
                     FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnSite" Content="Страница набора" Style="{StaticResource BtnGhost}"
                    Padding="10,6" FontSize="12" Margin="0,0,6,0"/>
            <Button x:Name="BtnSettings" Content="Настройки" Style="{StaticResource BtnGhost}"
                    Padding="10,6" FontSize="12"/>
          </StackPanel>
        </Grid>

        <!-- Страницы -->
        <Grid Grid.Row="2" Margin="18,0,18,12">
          <!-- Набор игроков: список серверов -->
          <ScrollViewer x:Name="PageSeed" VerticalScrollBarVisibility="Auto">
            <Border x:Name="ServersCard" Style="{StaticResource Card}">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="СЕРВЕРЫ" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="TxtTotalOnline" Style="{StaticResource HintText}" FontSize="12"
                             Foreground="{StaticResource Text1}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <ItemsControl x:Name="ServersList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="12,9" Margin="0,0,0,8" CornerRadius="10" BorderThickness="1">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#0AFFFFFF"/>
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
                                <Setter Property="Background" Value="#14F5B942"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}"
                                         FontWeight="SemiBold" ToolTip="{Binding FullName}"/>
                              <Border Visibility="{Binding TargetBadge}" Margin="10,0,0,0"
                                      Padding="8,2" CornerRadius="8" VerticalAlignment="Center"
                                      Background="{StaticResource PillBusyBg}">
                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource PillBusyFg}"/>
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource HintText}"
                                       FontSize="11" Margin="0,3,0,0"/>
                            <ProgressBar Style="{StaticResource SeedProgress}" Height="6"
                                         Margin="0,9,0,7" Minimum="0"
                                         Maximum="{Binding ProgressMax}" Value="{Binding Progress}"/>
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource HintText}" FontSize="11"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{Binding Online}" Style="{StaticResource BaseText}"
                                       FontWeight="SemiBold" Foreground="{StaticResource Amber}"
                                       HorizontalAlignment="Right"/>
                            <Button Content="Подключиться" Style="{StaticResource BtnConnect}"
                                    Padding="12,6" FontSize="12" Margin="0,7,0,0"
                                    IsEnabled="{Binding IsOnline}"
                                    Click="BtnConnectServer_Click"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TxtServersEmpty" Style="{StaticResource HintText}"
                           Text="Загружаю список серверов…"/>
              </StackPanel>
            </Border>
          </ScrollViewer>

          <!-- VIP и бонусы -->
          <Grid x:Name="PageVip" Visibility="Collapsed">
            <Border x:Name="VipCard" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="БОНУСЫ И VIP" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock x:Name="TxtVipBalance" Style="{StaticResource BaseText}" Text="—"/>
                  <TextBlock x:Name="TxtVipUntil" Style="{StaticResource HintText}"
                             Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtVipMissing" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                <Button x:Name="BtnBuyVip" Content="Получить VIP" IsEnabled="False"
                        Style="{StaticResource BtnAmber}" Padding="16,8" Margin="0,12,0,0"
                        HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="VipLoginHint" Style="{StaticResource HintText}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       Text="Войдите, чтобы увидеть баланс бонусов и статус VIP."/>
          </Grid>

          <!-- Журнал -->
          <Border Grid.Row="2" x:Name="PageJournal" Style="{StaticResource Card}"
                  Padding="18,12" Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="ЖУРНАЛ" Style="{StaticResource SectionTitle}"/>
              <ListBox x:Name="JournalList" Grid.Row="1" Margin="0,8,0,0"
                       Background="Transparent" BorderThickness="0"
                       FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="#B8F5F8FF"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0,1"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter/>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <!-- ═══ Сессия (скрыта до входа) ═══ -->
        <Border Grid.Row="3" x:Name="SessionCard" Style="{StaticResource Card}" Margin="18,0,18,12"
                Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="СЕССИЯ" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="TxtSeedState" Style="{StaticResource HintText}" Margin="0,7,0,2"
                         Text="Набор выключен" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="TxtTimer" Style="{StaticResource BaseText}" FontSize="24"
                           FontWeight="Bold" FontFamily="{StaticResource FontMono}"
                           Text="00:00:00"/>
                <TextBlock x:Name="TxtBonuses" Style="{StaticResource BaseText}" FontSize="14"
                           Foreground="{StaticResource Green}" VerticalAlignment="Bottom"
                           Margin="14,0,0,3" Text=""/>
              </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border x:Name="StatePill" CornerRadius="11" Padding="12,4"
                      Background="{StaticResource PillIdleBg}"
                      HorizontalAlignment="Right">
                <TextBlock x:Name="TxtPill" FontFamily="{StaticResource FontUi}" FontSize="11"
                           FontWeight="SemiBold" Foreground="{StaticResource PillIdleFg}"
                           Text="ВЫКЛЮЧЕНО"/>
              </Border>
              <Button x:Name="BtnStart" Grid.Row="1" Content="Начать набор"
                      Style="{StaticResource BtnAmber}" VerticalAlignment="Center"
                      HorizontalAlignment="Stretch" Padding="0,12"/>
              <Button x:Name="BtnStop" Grid.Row="1" Content="Стоп"
                      Style="{StaticResource BtnDanger}" VerticalAlignment="Center"
                      HorizontalAlignment="Stretch" Padding="0,12" Visibility="Collapsed"/>
            </Grid>
          </Grid>
        </Border>

        <!-- ═══ Плашка обновления (видна, когда на GitHub есть релиз новее) ═══ -->
        <Border Grid.Row="4" x:Name="UpdateBar" Margin="18,0,18,12" Padding="14,8"
                CornerRadius="10" Background="#1AF5B942" BorderBrush="{StaticResource Amber}"
                BorderThickness="1" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtUpdate" Style="{StaticResource BaseText}" FontSize="12.5"
                       VerticalAlignment="Center" Text="Доступна новая версия"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="BtnUpdateLater" Content="Позже" Style="{StaticResource BtnGhost}"
                      Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
              <Button x:Name="BtnUpdate" Content="Обновить" Style="{StaticResource BtnAmber}"
                      Padding="12,5" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ═══ Статус-бар ═══ -->
        <Grid Grid.Row="5" Margin="20,0,20,10">
          <TextBlock x:Name="TxtPublicStatus" Style="{StaticResource HintText}" FontSize="12"
                     Foreground="{StaticResource Text1}"
                     VerticalAlignment="Center" Text=""/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
