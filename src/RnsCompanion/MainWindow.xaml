<Window x:Class="RnsCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RnsCompanion.Controls"
        Title="RNS Companion" Width="800" MinHeight="560" MaxHeight="940"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

  <!-- Внешняя рамка: тень + скруглённые углы (Clip обновляется из кода) -->
  <Border x:Name="RootBorder" Margin="10" CornerRadius="16" Background="{StaticResource WindowBg}"
          BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- title bar -->
        <RowDefinition Height="Auto"/>  <!-- шапка -->
        <RowDefinition Height="Auto"/>  <!-- авторизация -->
        <RowDefinition Height="Auto"/>  <!-- бонусы и VIP -->
        <RowDefinition Height="Auto"/>  <!-- цель -->
        <RowDefinition Height="Auto"/>  <!-- сессия -->
        <RowDefinition Height="*" MinHeight="120"/>  <!-- журнал -->
        <RowDefinition Height="Auto"/>  <!-- плашка обновления -->
        <RowDefinition Height="Auto"/>  <!-- статус-бар -->
      </Grid.RowDefinitions>

      <!-- ═══ Кастомный title bar ═══ -->
      <Border Grid.Row="0" x:Name="TitleBar" Padding="14,6,8,6" Background="Transparent">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="18" Height="18"/>
            <TextBlock Text="RNS — Набор игроков" Style="{StaticResource BaseText}"
                       Foreground="{StaticResource Text2}" FontSize="12"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnMinimize" Content="—" Style="{StaticResource BtnChrome}"/>
            <Button x:Name="BtnClose" Content="✕" Style="{StaticResource BtnChromeClose}"
                    Margin="4,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══ Шапка ═══ -->
      <Grid Grid.Row="1" Margin="22,10,22,16">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="46" Height="46" CornerRadius="12" Background="#14FFFFFF"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="32" Height="32"
                   Margin="6"/>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Русский Народный Сервер" Style="{StaticResource BaseText}"
                       FontFamily="{StaticResource FontDisplay}" FontWeight="Bold"
                       FontSize="17"/>
            <TextBlock Text="Набор игроков на сервера Squad · rnserver.ru"
                       Style="{StaticResource HintText}" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="TxtUserName" Style="{StaticResource BaseText}"
                     Foreground="{StaticResource Text1}" VerticalAlignment="Center"
                     Margin="0,0,10,0" Visibility="Collapsed"/>
          <Button x:Name="BtnSite" Content="Страница набора" Style="{StaticResource BtnGhost}"
                  Padding="12,7" Margin="0,0,8,0"/>
          <Button x:Name="BtnSettings" Content="Настройки" Style="{StaticResource BtnGhost}"
                  Padding="12,7"/>
        </StackPanel>
      </Grid>

      <!-- ═══ Авторизация ═══ -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Margin="22,0,22,14" x:Name="AuthCard">
        <Grid>
          <!-- Не авторизован -->
          <StackPanel x:Name="LoginPanel">
            <TextBlock Text="АВТОРИЗАЦИЯ" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,14"
                       Text="Войдите через аккаунт сайта rnserver.ru — откроется браузер, после входа вы вернётесь сюда автоматически. К аккаунту должен быть привязан Steam."/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnLogin" Content="Войти через сайт" Style="{StaticResource BtnAmber}"/>
              <TextBlock x:Name="TxtAuthProgress" Style="{StaticResource HintText}"
                         VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>

          <!-- Авторизован -->
          <Grid x:Name="UserPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="АККАУНТ" Style="{StaticResource SectionTitle}"/>
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAccount" Style="{StaticResource BaseText}" Margin="9,0,0,0"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnLogout" Content="Выйти"
                    Style="{StaticResource BtnGhost}" Padding="12,7" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
      </Border>

      <!-- ═══ Бонусы и VIP (скрыта до входа) ═══ -->
      <Border Grid.Row="3" x:Name="VipCard" Style="{StaticResource Card}" Margin="22,0,22,14"
              Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="БОНУСЫ И VIP" Style="{StaticResource SectionTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
              <TextBlock x:Name="TxtVipBalance" Style="{StaticResource BaseText}" Text="—"/>
              <TextBlock x:Name="TxtVipUntil" Style="{StaticResource HintText}"
                         Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtVipMissing" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="BtnBuyVip" Content="Получить VIP" IsEnabled="False"
                  Style="{StaticResource BtnAmber}" Padding="14,8" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ═══ Серверы: живой список, цель набора выделена и первая ═══ -->
      <Border Grid.Row="4" x:Name="ServersCard" Style="{StaticResource Card}" Margin="22,0,22,14">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="СЕРВЕРЫ" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="TxtTotalOnline" Style="{StaticResource HintText}" FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <ItemsControl x:Name="ServersList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="12,9" Margin="0,0,0,8" CornerRadius="10" BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#0AFFFFFF"/>
                      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTarget}" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
                          <Setter Property="Background" Value="#14F5B942"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}"
                                   FontWeight="SemiBold" ToolTip="{Binding FullName}"/>
                        <Border Visibility="{Binding TargetBadge}" Margin="10,0,0,0"
                                Padding="8,2" CornerRadius="8" VerticalAlignment="Center"
                                Background="{StaticResource PillBusyBg}">
                          <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                                     Foreground="{StaticResource PillBusyFg}"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource HintText}"
                                 FontSize="11" Margin="0,2,0,0"/>
                      <ProgressBar Style="{StaticResource SeedProgress}" Height="6"
                                   Margin="0,7,0,4" Minimum="0"
                                   Maximum="{Binding ProgressMax}" Value="{Binding Progress}"/>
                      <TextBlock Text="{Binding Hint}" Style="{StaticResource HintText}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                      <TextBlock Text="{Binding Online}" Style="{StaticResource BaseText}"
                                 FontWeight="SemiBold" Foreground="{StaticResource Amber}"
                                 HorizontalAlignment="Right"/>
                      <Button Content="Подключиться" Style="{StaticResource BtnGhost}"
                              Padding="10,5" FontSize="11.5" Margin="0,7,0,0"
                              IsEnabled="{Binding IsOnline}"
                              Click="BtnConnectServer_Click"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="TxtServersEmpty" Style="{StaticResource HintText}"
                     Text="Загружаю список серверов…"/>
        </StackPanel>
      </Border>

      <!-- ═══ Сессия (скрыта до входа) ═══ -->
      <Border Grid.Row="5" x:Name="SessionCard" Style="{StaticResource Card}" Margin="22,0,22,14"
              Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="190"/>
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="СЕССИЯ" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="TxtSeedState" Style="{StaticResource HintText}" Margin="0,9,0,2"
                       Text="Набор выключен" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock x:Name="TxtTimer" Style="{StaticResource BaseText}" FontSize="26"
                         FontWeight="Bold" FontFamily="{StaticResource FontMono}"
                         Text="00:00:00"/>
              <TextBlock x:Name="TxtBonuses" Style="{StaticResource BaseText}" FontSize="15"
                         Foreground="{StaticResource Green}" VerticalAlignment="Bottom"
                         Margin="14,0,0,4" Text=""/>
            </StackPanel>
          </StackPanel>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="StatePill" CornerRadius="11" Padding="12,4"
                    Background="{StaticResource PillIdleBg}"
                    HorizontalAlignment="Right">
              <TextBlock x:Name="TxtPill" FontFamily="{StaticResource FontUi}" FontSize="11"
                         FontWeight="SemiBold" Foreground="{StaticResource PillIdleFg}"
                         Text="ВЫКЛЮЧЕНО"/>
            </Border>
            <Button x:Name="BtnStart" Grid.Row="1" Content="Начать набор"
                    Style="{StaticResource BtnAmber}" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch" Padding="0,10"/>
            <Button x:Name="BtnStop" Grid.Row="1" Content="Стоп"
                    Style="{StaticResource BtnDanger}" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch" Padding="0,10" Visibility="Collapsed"/>
          </Grid>
        </Grid>
      </Border>

      <!-- ═══ Журнал (скрыт по умолчанию, включается в настройках) ═══ -->
      <Border Grid.Row="6" x:Name="JournalCard" Style="{StaticResource Card}" Margin="22,0,22,12"
              Padding="18,12" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="ЖУРНАЛ" Style="{StaticResource SectionTitle}"/>
          <ListBox x:Name="JournalList" Grid.Row="1" Margin="0,8,0,0" MaxHeight="320"
                   Background="Transparent" BorderThickness="0"
                   FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="#B8F5F8FF"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0,1"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
      </Border>

      <!-- ═══ Плашка обновления (видна, когда на GitHub есть релиз новее) ═══ -->
      <Border Grid.Row="7" x:Name="UpdateBar" Margin="22,0,22,12" Padding="14,8"
              CornerRadius="10" Background="#1Af5b942" BorderBrush="{StaticResource Amber}"
              BorderThickness="1" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TxtUpdate" Style="{StaticResource BaseText}" FontSize="12.5"
                     VerticalAlignment="Center" Text="Доступна новая версия"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BtnUpdateLater" Content="Позже" Style="{StaticResource BtnGhost}"
                    Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
            <Button x:Name="BtnUpdate" Content="Обновить" Style="{StaticResource BtnAmber}"
                    Padding="12,5" FontSize="12"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══ Статус-бар ═══ -->
      <Grid Grid.Row="8" Margin="24,0,24,10">
        <TextBlock x:Name="TxtPublicStatus" Style="{StaticResource HintText}" FontSize="11"
                   VerticalAlignment="Center" Text=""/>
        <TextBlock x:Name="TxtVersion" Style="{StaticResource HintText}" FontSize="11"
                   HorizontalAlignment="Right"/>
      </Grid>
    </Grid>
  </Border>
</Window>
