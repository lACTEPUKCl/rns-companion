<Window x:Class="RnsCompanion.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение — RNS Companion" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border x:Name="RootBorder" Margin="10" CornerRadius="16" Background="{StaticResource WindowBg}"
          BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Border Grid.Row="0" x:Name="TitleBar" Padding="14,6,8,6" Background="Transparent">
        <Grid>
          <TextBlock x:Name="TxtTitle" Text="Подтверждение" Style="{StaticResource BaseText}"
                     Foreground="{StaticResource Text2}" FontSize="12"
                     VerticalAlignment="Center"/>
          <Button x:Name="BtnClose" Content="✕" Style="{StaticResource BtnChromeClose}"
                  HorizontalAlignment="Right"/>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18,6,22,16">
        <TextBlock x:Name="TxtMessage" Style="{StaticResource BaseText}"
                   Foreground="{StaticResource Text1}" TextWrapping="Wrap" LineHeight="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button x:Name="BtnCancel" Content="Отмена" Style="{StaticResource BtnGhost}"
                  Margin="0,0,10,0" Padding="14,7"/>
          <Button x:Name="BtnConfirm" Content="Подтвердить" Style="{StaticResource BtnAmber}"
                  Padding="14,7"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
